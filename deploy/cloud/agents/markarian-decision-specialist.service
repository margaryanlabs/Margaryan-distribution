[Unit]
Description=Decision Command fixed-path read-only worker diagnostics
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/margaryan-cloud/agents.env

[Service]
Type=oneshot
User=markarian
Group=markarian
WorkingDirectory=/opt/margaryan-distribution
EnvironmentFile=/etc/margaryan-cloud/agents.env
ExecStart=/usr/bin/env node /opt/margaryan-distribution/scripts/cloud/decision-specialist.mjs --diff /var/lib/margaryan-cloud/agents/decision.json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/margaryan-cloud/agents
StandardOutput=null
StandardError=journal
TimeoutStartSec=45

[Install]
WantedBy=multi-user.target
