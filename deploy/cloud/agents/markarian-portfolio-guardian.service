[Unit]
Description=Private read-only GitHub portfolio scan
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/margaryan-cloud/agents.env

[Service]
Type=oneshot
User=markarian
Group=markarian
WorkingDirectory=/opt/margaryan-distribution
EnvironmentFile=/etc/margaryan-cloud/agents.env
ExecStart=/usr/bin/node /opt/margaryan-distribution/scripts/cloud/portfolio-guardian.mjs --diff /var/lib/margaryan-cloud/agents/guardian.json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/margaryan-cloud/agents
StandardOutput=null
StandardError=journal
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
