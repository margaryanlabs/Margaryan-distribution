# Core
OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=gpt-5.6-terra
OPENAI_CONTENT_MODEL=gpt-5.6-luna
OPENAI_RESEARCH_MODEL=gpt-5.6-terra
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_VOICE=marin
APP_BASE_URL=http://localhost:3000
DEFAULT_TIMEZONE=UTC
VOICE_GATEWAY_WSS_URL=wss://your-voice-gateway.example.com/twilio
VOICE_CALLBACK_SECRET=
WORKER_SECRET=
AUTOPILOT_SECRET=

# Vercel Cron / Portfolio Director
CRON_SECRET=
PORTFOLIO_MAX_MISSIONS_PER_TICK=5
PORTFOLIO_LEAD_TARGET=25
PORTFOLIO_RESEARCH_PER_TICK=10
PORTFOLIO_OUTREACH_PER_TICK=5
PORTFOLIO_SMM_DAYS=7

# Optional durable state checkpoint. Point ONLY at the dedicated Distribution project.
DISTRIBUTION_SUPABASE_URL=
DISTRIBUTION_SUPABASE_SERVICE_ROLE_KEY=
DISTRIBUTION_STATE_ID=primary

# Operator auth
DISTRIBUTION_BASIC_USER=
DISTRIBUTION_BASIC_PASSWORD=

# Safety: runtime defaults to dry-run.
EXECUTION_ENABLED=false

# Google OAuth shared by Gmail + Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCESS_TOKEN=

# Gmail
GMAIL_ACCESS_TOKEN=
GMAIL_SENDER_EMAIL=

# Google Calendar
GOOGLE_CALENDAR_ID=primary

# X OAuth user token
X_USER_ACCESS_TOKEN=

# LinkedIn approved app/account
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202609

# Instagram Professional via Meta
META_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
META_GRAPH_VERSION=v23.0

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Distribution limits
MAX_EMAILS_PER_DAY=40
MAX_CALLS_PER_DAY=20
MAX_SOCIAL_POSTS_PER_DAY=12
MAX_MEETINGS_PER_DAY=20

# Automated provider retry policy
MAX_ACTION_RETRIES=3
RETRY_BASE_MINUTES=5
