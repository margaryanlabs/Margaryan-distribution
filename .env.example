# Core
OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=gpt-5.6-terra
OPENAI_CONTENT_MODEL=gpt-5.6-luna
OPENAI_RESEARCH_MODEL=gpt-5.6-terra
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
APP_BASE_URL=http://localhost:3000
VOICE_GATEWAY_WSS_URL=wss://your-voice-gateway.example.com/twilio
WORKER_SECRET=

# Safety: V0.2 defaults to dry-run. Turn on only after provider credentials are configured.
EXECUTION_ENABLED=false

# Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_ACCESS_TOKEN=
GMAIL_SENDER_EMAIL=

# X OAuth user token
X_USER_ACCESS_TOKEN=

# LinkedIn approved app/account
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202609

# Instagram Professional via Meta
META_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
META_GRAPH_VERSION=v23.0

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Distribution limits
MAX_EMAILS_PER_DAY=40
MAX_CALLS_PER_DAY=20
MAX_SOCIAL_POSTS_PER_DAY=12
